# ELEVEN v3 Web — Environment Variables Template
# Copy to .env.local for local persistence testing (never commit real secrets)

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
# Example: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase Service Role Secret Key (from Supabase Dashboard -> Project Settings -> API)
# CRITICAL: Server-side only. Never prefix with NEXT_PUBLIC_ or expose to client code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional salt for one-way client IP hashing (anti-PII rate limiting)
# Example: 32+ character random hex string
WAITLIST_SALT=
